#version 330

// ============================================================================
// BGB manual switches (moved to top for easy access - PD, edit these three
// and save; the shader file-watcher hot-reloads, no game restart needed).
// See the fuller explanation comments further down where these used to live.
// ============================================================================
// Manual "upper vanilla" toggle: flip this to true and save whenever PD is
// about to wear a bulky/loose torso garment (jacket, robe, padding, sweater/
// hoodie...) likely to ship a custom mesh that doesn't track the chest/belly/
// waist sculpt and would otherwise show the body poking through. No restart
// needed - the shader file-watcher recompiles on save like every other change
// this mod makes. (A Lua-automatic version of this switch turned out to be
// blocked: no accessible per-character scale setter in this game version, and
// Lua's file-writer is sandboxed to Zomboid/Lua/, so it can't touch this file.)
const bool UPPER_VANILLA_MODE = false;

// Foreign-vertex proximity match toggle (chest/belly/thigh/waist only - HEAD
// never used this path, see its own exact-ID-only comment below). Encapsulates
// the "not this exact body vertex, but a nearby clothing/foreign vertex within
// THRESHOLD" top-2-nearest blend fallback (the else{} branch in each region
// below) behind one flag, so the whole feature can be dropped or restored by
// flipping this single bool - no code deleted, nothing else touched.
//
// 2026-07-25: briefly set to false, then reverted back to true (current
// state). Root cause investigated: this same fallback is what lets male
// characters' OWN body mesh get pulled toward the (female-only) sculpt
// anchors - Bob and vanilla Kate share near-identical base chest topology,
// so ALL 70 of Bob's real Spine1-weighted chest vertices land inside the
// ~8cm CHEST_THRESHOLD radius as "foreign" near-matches, well inside the
// full-strength inner zone (confirmed by directly parsing MaleBody.x -
// farthest is 0.036, less than half the threshold). The vertex shader has
// no signal to tell Bob's mesh from Kate's (same bone names/indices,
// near-identical bind-pose coordinates), so this can't be gated by gender -
// the only lever is turning the whole fallback off, which is what setting
// this to false does. Trade-off if set false: it also disables the
// "tight-fitting clothing auto-follows the sculpted body" convenience for
// FEMALE outfits (the feature this fallback was originally written for) -
// only vertices that are an EXACT match (< EXACT_MATCH_EPS) to a real
// anchor would still get sculpted, i.e. the body's own vertices only.
const bool ENABLE_FOREIGN_PROXIMITY_MATCH = true;

// Master switch for the whole BGB sculpt (chest/belly/thigh/waist - this
// variant has no head region). false = every region's displacement is
// skipped entirely - bone skinning/animation still works normally
// (boneEffect is computed unconditionally in main(), this only gates the
// position/normal displacement blocks), so the character just renders at
// the vanilla body shape with the mod otherwise fully installed.
// Independent of and layered on top of UPPER_VANILLA_MODE (upper-body-only)
// and ENABLE_FOREIGN_PROXIMITY_MATCH (foreign-vertex-only) - this one flag
// overrides everything below it. Hot-reloads on save like the others.
const bool ENABLE_BGB_SCULPT = true;

layout (location = 0) in vec4 vertex;
layout (location = 1) in vec4 normal;
layout (location = 2) in vec4 boneWeights;
layout (location = 3) in vec4 boneIndices;
layout (location = 4) in vec2 uv;

out vec3 vertColour;
out vec3 vertNormal;
out vec2 texCoords;

uniform mat4 ModelViewProjection;
uniform float targetDepth = 0.5;
uniform float DepthBias;
uniform mat4 MatrixPalette[60];
uniform vec2 UVScale = vec2(1,1);
uniform float HighResDepthMultiplier = 0.0; // 0.5 when drawing models to double-sized chunk textures
uniform float FinalScale = 1.0;

// --- Baby Got Back - Normal: sculpted vertex deltas (chest + belly + thighs + waist) ---
// Same data/pipeline as Baby Got Back - Cute minus the head region and minus the
// custom texture - this variant keeps the vanilla face and vanilla skin texture.
// Mutually exclusive with BabyGotBack_Cute via mod.info incompatible=.
//
// v11 (sculpt source: BGB_Cute10.obj):
// - PROXIMITY matching in bind-pose local space for body regions: each region
//   ships (original position, delta) anchor pairs; any vertex passing the
//   region's bone-weight gate finds its nearest anchor within a threshold radius
//   and applies that delta with smoothstep falloff. Tight-fitting clothing
//   follows the body shape automatically with zero per-item authoring.
// - ZERO-DELTA anchors: every body vertex passing a region's gate is in the
//   table (unsculpted ones with vec3(0)), so body vertices always match
//   themselves exactly and unsculpted areas are never dragged sideways.
// - WAIST region added (Bip01_Spine-dominant band, y~0.57-0.62) - these 15
//   sculpted verts were previously dropped as "unclassified" which visibly broke
//   the intended waist/hip line. THIGH gate now also counts the DressFront/
//   DressBack helper bones (crotch centreline verts split their weight there).
// v12: nearest-single-anchor matching caused a hard seam wherever two adjacent
//   clothing vertices picked a different "closest" anchor - visible as jagged
//   sawtooth clipping around cutout-style clothing (e.g. a diamond chest cutout
//   sweater). v12's first attempt (weighted blend of EVERY anchor in range)
//   overcorrected: it diluted real deltas towards zero wherever a sculpted
//   anchor sits near many zero-delta anchors (the whole chest went back to
//   vanilla). Fixed by blending only the top-2 nearest anchors, weighted by how
//   close their distances are to each other (tied -> 50/50, one clearly nearer
//   -> pure nearest).
// v13: top-2-nearest still let a zero-delta anchor win outright for foreign
//   (clothing) vertices whose spacing/density differs from the body's own -
//   found on a half-hoodie whose chest panel mostly matched zero anchors and
//   never moved, unlike a fitted shirt that happened to land near real anchors.
//   Fixed with a two-phase match: an exact (~0 distance) hit against ANY anchor
//   (real or zero) means this IS the body's own vertex, use its delta directly;
//   otherwise this is a foreign vertex, so search ONLY real (non-zero) anchors
//   for the top-2 blend - zero anchors never compete for clothing.
// v14: position displacement alone isn't enough - the shading NORMAL was never
//   touched, so a garment bulged out by two adjacent regions kept the flat
//   original normal at the valley between them, which can point almost
//   straight away from the light there and render as a solid black wedge
//   (found on a cropped hoodie, right where the two chest anchors' deltas
//   meet). Fixed by tilting the bind-pose normal towards the total applied
//   displacement (NORMAL_ADJUST_STRENGTH, tunable) before skinning. (Turned out
//   NOT to be the actual cause of the hoodie clipping below - kept anyway since
//   it's a real, separate shading improvement.)
// v15: the real cause of the hoodie clipping - top-2-nearest DIRECTION blending
//   (v12/v13) was also being used for MAGNITUDE, which undershoots badly
//   whenever the nearest real anchor(s) happen to be low-magnitude peripheral
//   points rather than the true bump peak (anchors are coarse, only ~67 points
//   across the whole chest). A clothing vertex sitting offset from the body
//   needs to move by at least the peak amount nearby, not an interpolated
//   average of it, or the body pokes through. Fixed by keeping the smooth
//   top-2 blend for DIRECTION only, and taking MAGNITUDE as the larger of the
//   two candidate anchors' own magnitudes.
//
// SkeletonBone ordinals (fixed, engine-wide): Dummy01=0, Bip01=1,
// Bip01_Pelvis=2, Bip01_Spine=3, Bip01_Spine1=4, Bip01_Neck=5, Bip01_Head=6,
// Bip01_L_Thigh=20, Bip01_R_Thigh=24, Bip01_DressFront=28, Bip01_DressBack=30.
const int CHEST_BONE_INDEX = 4;
const int PELVIS_BONE_INDEX = 2;
const int SPINE_BONE_INDEX = 3;
const int L_THIGH_BONE_INDEX = 20;
const int R_THIGH_BONE_INDEX = 24;
const int DRESS_FRONT_BONE_INDEX = 28;
const int DRESS_BACK_BONE_INDEX = 30;
const float SCULPT_SCALE = 1.0; // overall multiplier on all deltas below

// Proximity radius (bind-pose local units, ~meters) and inner full-strength
// fraction per region - tunable.
// Distance below which a vertex is considered THE body's own anchor point
// rather than a foreign (clothing) vertex merely sitting nearby - see
// proximityBlock() header comment. Body/anchor positions are float-identical
// (both come from the same source data), so this only needs to be bigger than
// float noise and smaller than the closest real clothing vertex we've seen
// (~0.003 on a hoodie collar hem).
const float EXACT_MATCH_EPS = 0.0008;

// How strongly the shading normal follows the displacement direction (see
// main() below) - 0 = old behaviour (normal never changes), higher = more
// correction for the crease/valley where two pushed regions meet. Tunable.
const float NORMAL_ADJUST_STRENGTH = 4.0;

// UPPER_VANILLA_MODE / ENABLE_FOREIGN_PROXIMITY_MATCH / ENABLE_BGB_SCULPT
// moved to the top of the file (right after #version) for easy access.

const float CHEST_THRESHOLD = 0.080;
const float CHEST_INNER = 0.85;
const float CHEST_BLEND_BAND = 0.010;
const float BELLY_THRESHOLD = 0.030;
const float BELLY_INNER = 0.5;
const float BELLY_BLEND_BAND = 0.010;
const float THIGH_THRESHOLD = 0.045;
const float THIGH_INNER = 0.5;
const float THIGH_BLEND_BAND = 0.010;
const float WAIST_THRESHOLD = 0.045;
const float WAIST_INNER = 0.5;
const float WAIST_BLEND_BAND = 0.010;

