	vec3(0.00000,-0.00172,-0.00516), vec3(-0.01326,0.00145,0.01376), vec3(-0.01326,0.00145,0.01376),
	vec3(-0.00236,0.00943,0.00070), vec3(0.00110,0.00093,-0.00504), vec3(0.00065,-0.00511,-0.00716),
	vec3(0.00568,0.01183,0.00204), vec3(0.00000,0.01135,0.00000), vec3(0.00000,-0.00900,0.00998),
	vec3(0.00000,-0.00900,0.00998), vec3(0.00000,-0.00172,-0.00516), vec3(0.00000,0.00570,-0.00331),
	vec3(0.00000,0.00570,-0.00331), vec3(0.00000,0.02208,0.00044), vec3(0.00000,0.02208,0.00044),
	vec3(0.00000,0.02208,0.00044), vec3(0.00000,0.00858,-0.01341), vec3(0.00000,0.00858,-0.01341),
	vec3(0.00000,0.01221,0.00645), vec3(-0.00304,0.00116,0.00170), vec3(-0.00141,-0.01087,0.00005),
	vec3(0.00388,0.00060,0.00000), vec3(0.00000,-0.00172,-0.00516), vec3(0.01326,0.00145,0.01376),
	vec3(0.01326,0.00145,0.01376), vec3(0.00236,0.00943,0.00070), vec3(-0.00110,0.00093,-0.00504),
	vec3(-0.00065,-0.00511,-0.00716), vec3(-0.00568,0.01183,0.00204), vec3(0.00000,0.01135,0.00000),
	vec3(-0.00017,-0.00312,0.00025), vec3(0.00000,0.00000,0.00000), vec3(0.00062,0.01609,-0.00096),
	vec3(0.00062,0.01609,-0.00096), vec3(0.00000,0.01903,0.00761), vec3(0.00000,0.01729,0.00871),
	vec3(0.00000,0.01530,0.00021), vec3(0.00000,0.01729,0.00871), vec3(0.00017,-0.00312,0.00025),
	vec3(0.00000,0.00000,0.00000), vec3(-0.00062,0.01609,-0.00096), vec3(-0.00062,0.01609,-0.00096),
	vec3(0.00000,0.01729,0.00871), vec3(0.00000,0.00000,0.00000), vec3(0.00000,0.01530,0.00021),
	vec3(0.00000,0.00000,0.00000)
