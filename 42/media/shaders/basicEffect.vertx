	vec3(0.06131,0.46288,-0.01349), vec3(0.02889,0.36173,0.01711), vec3(0.02889,0.36173,0.01711),
	vec3(-0.06131,0.46288,-0.01349), vec3(-0.02889,0.36173,0.01711), vec3(-0.02889,0.36173,0.01711),
	vec3(0.06131,0.46288,-0.01349), vec3(0.01130,0.46186,-0.02042), vec3(-0.01172,0.46202,-0.02022),
