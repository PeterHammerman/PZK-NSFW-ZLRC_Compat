const int THIGH_SCULPT_COUNT = 35;
const int THIGH_REAL_COUNT = 24;
const vec3 THIGH_SCULPT_ORIG[35] = vec3[35](
	vec3(-0.10680,0.36736,0.02020), vec3(-0.09954,0.46550,0.02254), vec3(-0.07444,0.36447,-0.00732),
	vec3(-0.07444,0.36447,-0.00732), vec3(-0.04578,0.36660,0.07912), vec3(-0.09082,0.43923,0.07519),
	vec3(-0.09082,0.43923,0.07519), vec3(-0.09331,0.37232,0.07147), vec3(-0.09331,0.37232,0.07147),
	vec3(-0.02131,0.37215,-0.01824), vec3(-0.04184,0.37305,0.08668), vec3(0.00000,0.37537,0.08761),
	vec3(0.00000,0.37289,-0.02130), vec3(0.10680,0.36736,0.02020), vec3(0.09954,0.46550,0.02254),
	vec3(0.07444,0.36447,-0.00732), vec3(0.07444,0.36447,-0.00732), vec3(0.04578,0.36660,0.07912),
